{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "esnext",
        "lib": ["ESNext", "DOM"],
        "moduleResolution": "bundler",
        "strict": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "types": ["node"]
    },
    "include": [
        "src",
        "vite-env.d.ts",
        "eslint.config.ts",
        "requests",
        "domain-objects",
        "logging",
        "configs",
        "dtos"
    ]
}
